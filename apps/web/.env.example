# CRM EUROVIA — exemplo sem credenciais reais
# PREENCHER SOMENTE com o projeto Supabase exclusivo CRM EUROVIA.
# NUNCA utilizar projeto, URLs ou chaves do MVP-Creator.
# NEXT_PUBLIC_* fica acessivel no navegador: nunca colocar segredos aqui.

NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO_EUROVIA.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUA_CHAVE_PUBLICAVEL_SUPABASE"

# Endereco HTTPS da API CRM Eurovia, quando a API estiver implantada.
NEXT_PUBLIC_API_URL="https://api.SEU_DOMINIO_CONFIRMADO"

# Endereco do frontend CRM Eurovia
NEXT_PUBLIC_APP_URL="https://SEU_DOMINIO_CONFIRMADO"
NEXT_PUBLIC_APP_NAME="CRM EUROVIA"

# Publica apenas o DSN, nunca o token de upload de sourcemaps.
NEXT_PUBLIC_SENTRY_DSN=""
