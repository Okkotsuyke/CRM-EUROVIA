# CRM EUROVIA / API Fastify — MODELO, nao usar com dados reais em Git
# Projeto Supabase exclusivo: crm-eurovia. Nunca usar credenciais MVP-Creator.
#
# Configure apenas no ambiente correspondente (local / preview / production).
# NUNCA commitar .env, cookies de sessao ou tokens.

# Banco: copiar URI exata do Supabase CRM Eurovia. Para serverless,
# escolher a conexao/pooler compativel com Prisma e regiao efetiva.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require"
# Usada SOMENTE para migrações, em identidade separada quando configurada.
DIRECT_URL="postgresql://MIGRATOR:PASSWORD@HOST:PORT/postgres?sslmode=require"

# Login atual: JWT Fastify legado; migracao Supabase Auth pendente.
JWT_SECRET="PREENCHA_NO_GERENCIADOR_DE_SEGREDOS_MINIMO_32_CARACTERES"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Origem do frontend autorizada a chamar API (HTTPS em production).
CRM_ALLOWED_ORIGINS="http://localhost:3000"

# Segredo forte para Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="PREENCHA_NO_GERENCIADOR_DE_SEGREDOS_MINIMO_32_CARACTERES"

# Syonet SOMENTE LEITURA (por padrao INATIVO, sem contato externo).
# Credenciais somente quando houver conta de consulta homologada.
SYONET_USE_REAL="false"
SYONET_URL="https://viasul.syonet.com"
SYONET_USERNAME=""
SYONET_PASSWORD=""
SYONET_HEADLESS="true"
SYNC_ENABLED="false"

# Erros (projeto correto no Sentry, configurado na API).
SENTRY_DSN=""

# E-mails (envios reais exigem dominio e contas aprovados).
RESEND_API_KEY=""
EMAIL_FROM=""

NODE_ENV="development"
PORT="3001"
