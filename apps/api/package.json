    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.7.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "fastify": "^4.28.0",
    "fastify-plugin": "^4.5.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.64.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@vercel/node": "^3.0.0",
    "@vitest/ui": "^1.6.0",
