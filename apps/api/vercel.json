{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npx --yes pnpm@9.0.0 install --frozen-lockfile",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "regions": [
    "gru1"
  ],
  "git": {
    "deploymentEnabled": {
      "fix/eurovia-hardening-deploy-20261015": false
    }
  }
}
