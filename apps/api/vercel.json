{
  "version": 2,
  "framework": null,
  "installCommand": "npx --yes pnpm@9.0.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@9.0.0 --filter @crm/api build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": [
        "src/**",
        "prisma/**"
      ]
    }
  },
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
