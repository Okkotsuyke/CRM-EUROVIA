{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npx --yes pnpm@9.0.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@9.0.0 --filter @crm/api build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/eurovia-hardening-deploy-20261015": false
    }
  }
}
