{
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @crm/api build",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "regions": ["gru1"],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
