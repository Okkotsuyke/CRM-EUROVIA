# Build context must be the monorepo root.
# Railway service: crm-eurovia-web
# RAILWAY_DOCKERFILE_PATH=Dockerfile.railway.web
FROM node:24-bookworm-slim AS builder

WORKDIR /opt/crm
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@9.0.0

# pnpm may also execute API workspace postinstall while installing the web
# filter; keep the Prisma schema available from the very first install.
COPY . .
RUN pnpm install --frozen-lockfile --filter '@crm/web...'
RUN mkdir -p apps/web/public
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @crm/web run build

FROM node:24-bookworm-slim AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /opt/crm

# outputFileTracingRoot is the monorepo root in apps/web/next.config.js.
COPY --from=builder --chown=node:node /opt/crm/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /opt/crm/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=node:node /opt/crm/apps/web/public ./apps/web/public

USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
