# Build context must be the monorepo root.
# Railway service: crm-eurovia-api
# RAILWAY_DOCKERFILE_PATH=Dockerfile.railway.api
FROM node:24-bookworm-slim

WORKDIR /opt/crm

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@9.0.0

# Prisma runs 'postinstall' during pnpm install. Its schema must already be
# present, and OpenSSL must exist before Prisma detects its runtime target.
COPY . .
RUN pnpm install --frozen-lockfile --filter '@crm/api...'

# Unlike ephemeral serverless functions, this container has its own Chromium.
# Browser binaries and native Linux libraries are installed during image build.
# Playwright's executablePath() always matches its pinned runtime version.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# Run the playwright-core 1.63 CLI exactly, not the root playwright 1.64 CLI.
# Mismatched browser revisions can compile but fail when a real sync runs.
RUN node apps/api/node_modules/playwright-core/cli.js install --with-deps chromium
RUN pnpm --filter @crm/api run build

RUN chmod -R a+rX /opt/ms-playwright

ENV NODE_ENV=production
ENV SYONET_HEADLESS=true
ENV PORT=3001

WORKDIR /opt/crm/apps/api
USER node
EXPOSE 3001
CMD ["node", "dist/src/server.js"]
